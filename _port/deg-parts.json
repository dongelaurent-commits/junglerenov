{"head":"<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<script src=\"./support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n  <title>Simulation — adaptation à la perte d’autonomie — JungleRenov</title>\n  <meta name=\"robots\" content=\"noindex\">\n  <link rel=\"stylesheet\" href=\"_ds/junglerenov-design-system-fc00822c-9a4f-4aa5-96e5-e2f9567f58f8/styles.css\">\n  <link rel=\"stylesheet\" href=\"lib/components.css\">\n  <link rel=\"icon\" type=\"image/svg+xml\" href=\"assets/favicon-couleur-32.svg\">\n  <script src=\"_ds/junglerenov-design-system-fc00822c-9a4f-4aa5-96e5-e2f9567f58f8/_ds_bundle.js\"></script>\n  <script src=\"lib/jr-v2.js\"></script>\n  <script src=\"lib/_geo.js\"></script>\n  <script src=\"lib/_baremes_sources.js\"></script>\n  <script src=\"lib/_travaux_catalog.js\"></script>\n  <script src=\"lib/_compute_aids.js\"></script>\n  <script src=\"lib/_storage.js\"></script>\n  <script src=\"lib/_dossiers.js\"></script>\n  <script src=\"lib/_transmission.js\"></script>\n</helmet>\n<div class=\"jr2\" data-screen-label=\"Tunnel autonomie\" style=\"background: var(--jr-surface-page); min-height: 100vh; display: flex; flex-direction: column;\">\n  <div style=\"width: 100%; max-width: var(--jr-container); margin: 0 auto; padding: 0 {{ gut }}; box-sizing: border-box; display: flex; flex-direction: column; gap: {{ vGap }};\">\n    <x-import component-from-global-scope=\"JRv2.TunnelHeader\" compact=\"{{ narrow }}\" hint-size=\"100%,64px\"></x-import>\n    <x-import component-from-global-scope=\"JRv2.Stepper\" steps=\"{{ steps }}\" current=\"{{ stepIdx }}\" surface=\"light\" on-step-click=\"{{ jump }}\" scroll=\"{{ notWide }}\" min-width=\"0\" hint-size=\"100%,104px\"></x-import>\n  </div>\n\n  <main style=\"flex: 1; width: 100%; max-width: var(--jr-container); margin: 0 auto; padding: {{ titleTop }} {{ gut }} var(--jr-s-5); box-sizing: border-box; display: grid; grid-template-columns: {{ cols }}; column-gap: var(--jr-gutter); row-gap: var(--jr-s-5); align-items: start;\">\n    <div ref=\"{{ formRef }}\" style=\"grid-column: {{ formSpan }}; display: flex; flex-direction: column; gap: {{ blockGap }}; min-width: 0;\">","tail":"    </div>\n\n    <div style=\"grid-column: {{ recapSpan }}; margin-top: {{ recapTop }}; position: {{ recapPos }}; top: var(--jr-s-5); min-width: 0; max-height: {{ recapMax }}; overflow-y: auto;\">\n      <x-import component-from-global-scope=\"JRv2.ProjectRecap\" rows=\"{{ recap }}\" title=\"{{ recapTitle }}\" footer=\"{{ recapFooter }}\" hint-size=\"100%,360px\"></x-import>\n    </div>\n  </main>\n\n  <sc-if value=\"{{ showFooter }}\" hint-placeholder-val=\"{{ true }}\">\n    <x-import component-from-global-scope=\"JRv2.StickyFooter\" on-prev=\"{{ prev }}\" prev-disabled=\"{{ isFirst }}\" on-next=\"{{ next }}\" next-label=\"{{ nextLabel }}\" loading=\"{{ sending }}\" narrow=\"{{ narrow }}\" hint-size=\"100%,80px\"></x-import>\n  </sc-if>\n  <div aria-hidden=\"true\" style=\"height: {{ footGap }};\"></div>\n  <dc-import name=\"site-footer\" compact=\"{{ true }}\" hint-size=\"100%,200px\"></dc-import>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script>\nclass Component extends DCLogic {\n  state = { step: 1, w: window.innerWidth, s: { type: '', occ: '', who: '', age: '', gir: '', hand: '', foyer: '', rfr: '', works: [], pdfEmail: '', pdfConsent: false }, err: {}, addr: null, addrQuery: '', sug: [], sugMsg: '', resumed: false, libs: false, calc: 0, result: null, worksTouched: false, pdfSent: false, recapOff: 0 };\n  KEY = 'junglerenov.tunnel.autonomie';\n  STEPS = ['Logement', 'Personne', 'Âge', 'Handicap', 'Revenus', 'Aménagements', 'Calcul', 'Résultats'];\n  formRef = React.createRef();\n  goStep(n) { n = Math.max(1, Math.min(8, n)); clearInterval(this.calcT); this.setState({ step: n, err: {} }); window.scrollTo(0, 0); if (n === 7) this.runCalc(); }\n  save(s, addr) { try { localStorage.setItem(this.KEY, JSON.stringify({ s, addr })); } catch (_) {} }\n  componentDidMount() {\n    this.onR = () => this.setState({ w: window.innerWidth }); window.addEventListener('resize', this.onR);\n    this.libT = setInterval(() => { if (window.RFGeo && window.RFCompute && window.RFDossiers) { clearInterval(this.libT); this.setState({ libs: true }); } }, 50);\n    const q = new URLSearchParams(location.search);\n    try {\n      if (q.get('fresh') === '1') { localStorage.removeItem(this.KEY); q.delete('fresh'); history.replaceState(null, '', location.pathname + (q.toString() ? '?' + q : '') + location.hash); return; }\n      const saved = JSON.parse(localStorage.getItem(this.KEY) || 'null'); if (!saved) return;\n      const s = Object.assign({}, this.state.s, saved.s || {}); if (!Array.isArray(s.works)) s.works = [];\n      const any = !!saved.addr || Object.keys(s).some(k => Array.isArray(s[k]) ? s[k].length : s[k]);\n      this.setState({ s, addr: saved.addr || null, addrQuery: saved.addr ? saved.addr.label : '', resumed: any });\n    } catch (_) {}\n  }\n  componentDidUpdate() { this.alignRecap(); }\n  alignRecap() {\n    const col = this.formRef.current; if (!col) return; let off = 0;\n    if (this.state.w >= 1024) { const card = col.querySelector('section'); if (card) off = Math.round(card.getBoundingClientRect().top - col.getBoundingClientRect().top); }\n    if (Math.abs(off - (this.state.recapOff || 0)) > 1) this.setState({ recapOff: off });\n  }\n  componentWillUnmount() { window.removeEventListener('resize', this.onR); clearTimeout(this.deb); clearInterval(this.libT); clearInterval(this.calcT); }\n  update(k, v) {\n    this.setState(st => { const s = Object.assign({}, st.s, { [k]: v }); if (k === 'age' && v !== '60-69') s.gir = ''; const err = Object.assign({}, st.err); delete err[k]; this.save(s, st.addr); return { s, err, worksTouched: st.worksTouched || k === 'works' }; });\n  }\n  onAddr(val) {\n    const err = Object.assign({}, this.state.err); delete err.addr; this.setState({ addrQuery: val, addr: null, err }); clearTimeout(this.deb);\n    const q = val.trim(); if (q.length < 5) { this.setState({ sug: [], sugMsg: '' }); return; }\n    this.deb = setTimeout(() => this.fetchBan(q), 250);\n  }\n  async fetchBan(q) {\n    this.lastQ = q;\n    try {\n      const r = await fetch('https://api-adresse.data.gouv.fr/search/?q=' + encodeURIComponent(q) + '&limit=6&autocomplete=1'); if (!r.ok) throw new Error('BAN ' + r.status);\n      const j = await r.json(); if (q !== this.lastQ) return;\n      const sug = (j.features || []).map(f => ({ label: f.properties.label, postcode: f.properties.postcode, city: f.properties.city, citycode: f.properties.citycode, context: f.properties.context }));\n      this.setState({ sug, sugMsg: sug.length ? '' : 'Aucune adresse trouvée. Vérifiez la saisie, ou indiquez la rue et la commune.' });\n    } catch (e) { if (q === this.lastQ) this.setState({ sug: [], sugMsg: 'Le service d’adresses ne répond pas. Réessayez dans un instant.' }); }\n  }\n  pick(it) {\n    const cp = String(it.postcode || ''); const dep = /^20/.test(cp) ? (parseInt(cp.slice(2), 10) >= 200 ? '2B' : '2A') : cp.slice(0, 2);\n    const addr = Object.assign({}, it, { dep }); this.setState({ addr, addrQuery: it.label, sug: [], sugMsg: '', err: {} }); this.save(this.state.s, addr);\n  }\n  zone() { const a = this.state.addr; if (!a || !window.RFGeo) return null; return window.RFGeo.check(a.postcode); }\n  num(v) { const n = parseInt(String(v || '').replace(/\\D/g, ''), 10); return Number.isFinite(n) ? n : 0; }\n  payload(over) {\n    const s = this.state.s, a = this.state.addr || {};\n    return Object.assign({ rfr: this.num(s.rfr), foyer: Number(s.foyer) || 1, region: 'Grand Est',\n      age: ({ 'lt60': 55, '60-69': 65, '70+': 75 })[s.age] || 0, gir: s.gir && s.gir !== 'nsp' ? Number(s.gir) : null,\n      handicap: s.hand === 'inconnu' || !s.hand ? 'non' : s.hand, travaux: s.works.slice(), amoType: 'complet',\n      logement: { adresse: a.label || null, codePostal: a.postcode || null, ville: a.city || null, dept: a.dep || null, codeInsee: a.citycode || null, region: 'Grand Est', type: s.type || null } }, over || {});\n  }\n  runCalc() {\n    let result = null; const payload = this.payload();\n    try { result = window.RFCompute.computeMprAdapt(payload); localStorage.setItem('junglerenov.autonomie.result', JSON.stringify({ input: Object.assign({}, payload, { who: this.state.s.who, occupation: this.state.s.occ }), result, computedAt: new Date().toISOString() })); } catch (e) { console.error('[calcul]', e); }\n    this.setState({ calc: 0, result });\n    this.calcT = setInterval(() => { const c = this.state.calc + 1; if (c > 6) { clearInterval(this.calcT); if (result) this.goStep(8); return; } this.setState({ calc: c }); }, 450);\n  }\n  validate(step) {\n    const s = this.state.s, err = {};\n    if (step === 1) { if (!s.type) err.type = 'Choisissez le type de logement.'; if (!s.occ) err.occ = 'Indiquez si vous êtes propriétaire ou locataire.'; }\n    if (step === 2 && !s.who) err.who = 'Indiquez la personne concernée.';\n    if (step === 3) { if (!s.age) err.age = 'Choisissez une tranche d’âge.'; if (s.age === '60-69' && !s.gir) err.gir = 'Choisissez un niveau GIR, ou « Je ne sais pas ».'; }\n    if (step === 4 && !s.hand) err.hand = 'Choisissez une réponse pour continuer.';\n    if (step === 5) { const r = this.num(s.rfr); if (!r || r > 2000000) err.rfr = 'Indiquez votre revenu fiscal de référence, en euros.'; if (!s.foyer) err.foyer = 'Indiquez le nombre de personnes au foyer.'; }\n    if (step === 6 && !s.works.length) err.works = true;\n    return err;\n  }\n  renderVals() {\n    const w = this.state.w, narrow = w < 640, wide = w >= 1024, s = this.state.s, J = window.JRv2, zone = this.zone(), step = this.state.step, h = React.createElement, C = window.RFCompute;\n    const v = e => (e && e.target ? e.target.value : e);\n    const set = {}; ['type', 'occ', 'who', 'age', 'gir', 'hand', 'foyer', 'rfr', 'works', 'pdfEmail'].forEach(k => { set[k] = e => this.update(k, v(e)); });\n    const eur = n => Math.round(n || 0).toLocaleString('fr-FR').replace(/\\s/g, '\\u202f') + '\\u202f€';\n    const o = arr => arr.map(([value, label, description, icon]) => ({ value, label, description, icon }));\n    const optType = o([['maison', 'Maison individuelle', 'Pavillon, fermette, longère'], ['appartement', 'Appartement', 'En copropriété ou non']]);\n    const optOcc = o([['proprietaire', 'Propriétaire', 'Vous possédez le logement'], ['locataire', 'Locataire', 'Avec l’accord du propriétaire']]);\n    const optWho = o([['moi', 'Moi-même', 'Je vis dans ce logement'], ['conjoint', 'Mon conjoint', 'Mari, femme ou partenaire'], ['ascendant', 'Un parent', 'Père, mère, beau-parent'], ['descendant', 'Un enfant', 'Majeur ou mineur'], ['autre', 'Une autre personne', 'Membre du foyer']]);\n    const optAge = o([['lt60', 'Moins de 60 ans', 'Selon le handicap'], ['60-69', '60 à 69 ans', 'Selon le niveau GIR'], ['70+', '70 ans ou plus', 'Sans autre condition']]);\n    const optGir = [['1', 'GIR 1 — dépendance totale'], ['2', 'GIR 2'], ['3', 'GIR 3'], ['4', 'GIR 4'], ['5', 'GIR 5'], ['6', 'GIR 6 — autonomie préservée'], ['nsp', 'Je ne sais pas']].map(([value, label]) => ({ value, label }));\n    const optHand = o([['non', 'Non', 'Pas de reconnaissance'], ['oui_50plus', 'Taux d’incapacité ≥ 50\\u202f%', 'Reconnu par la MDPH'], ['oui_pch', 'Bénéficiaire de la PCH', 'Prestation de compensation'], ['inconnu', 'Je ne sais pas', 'À vérifier avec la MDPH']]);\n    const optFoyer = ['1', '2', '3', '4', '5', '6'].map(n => ({ value: n, label: n === '6' ? '6+' : n }));\n    const lab = (arr, val) => (arr.find(x => x.value === val) || {}).label;\n    // éligibilité personne (moteur, revenus neutralisés)\n    let elig = null;\n    if (C && C.computeMprAdapt && s.age && s.hand) { try { elig = C.computeMprAdapt(this.payload({ rfr: 1, foyer: 1, travaux: [] })).eligibilite; } catch (_) {} }\n    const handYes = s.hand === 'oui_50plus' || s.hand === 'oui_pch';\n    const eligState = !s.hand ? null : s.hand === 'inconnu' ? 'check' : handYes ? 'hand' : s.age === '70+' ? 'age' : s.age === '60-69' ? 'gir' : (elig && elig.personne ? 'age' : 'no');\n    const ELIG = { hand: ['valide', 'Éligible sans condition d’âge'], age: ['valide', 'Éligible selon l’âge'], gir: ['en-cours', 'Éligible selon l’âge et le GIR'], check: ['en-cours', 'À vérifier'], no: ['action', 'D’autres aides sont possibles : APA, PCH, caisses de retraite'] };\n    let cat = null, taux = null, revOk = null;\n    if (C && C.computeMprAdapt && this.num(s.rfr) && s.foyer) { try { const r0 = C.computeMprAdapt(this.payload({ travaux: [] })); cat = r0.eligibilite.categorie; taux = r0.aide.tauxApplique; revOk = r0.eligibilite.revenu; } catch (_) {} }\n    const CAT = { bleus: 'Très modestes', jaunes: 'Modestes', violets: 'Intermédiaires', roses: 'Aisés' };\n    const catTitle = cat ? 'Catégorie Anah : ' + CAT[cat] + (revOk ? ' — taux MaPrimeAdapt’ ' + Math.round(taux * 100) + '\\u202f%, plafond 22\\u202f000\\u202f€ HT.' : ' — d’autres aides restent possibles : APA, caisses de retraite.') : '';\n    const LIB = (C && C.MPA_LIBELLES) || {}, COST = (C && C.MPA_COUTS_INDICATIFS) || {}, GR = (C && C.MPA && C.MPA.travauxEligibles) || {};\n    const SHORT = { douche_italienne: 'Douche italienne', nouvelle_piece: 'Nouvelle pièce ≤ 20\\u202fm²', motorisation_volets: 'Motorisation de volets', cheminement_exterieur: 'Cheminement extérieur', amenagement_parking: 'Place de stationnement', volets_roulants_electriques: 'Volets roulants électriques', elargissement_passages: 'Élargissement des passages', revetement_antiderapant: 'Sol antidérapant', mitigeur_thermostatique: 'Mitigeur thermostatique' };\n    const ICON = { salle_de_bain: 'logement', accessibilite: 'proprietaire', autres_amenagements: 'devis' };\n    const nm = k => SHORT[k] || LIB[k] || k;\n    const workGroups = [['Salle de bain', 'salle_de_bain'], ['Accessibilité', 'accessibilite'], ['Autres', 'autres_amenagements']].map(([title, key], i) => ({ title, name: 'w-' + key,\n      options: (GR[key] || []).map(k => ({ value: k, label: nm(k), description: 'Coût moyen ' + eur(COST[k]), icon: ICON[key] })),\n      wrap: { display: 'flex', flexDirection: 'column', gap: 'var(--jr-s-3)', paddingTop: i ? 'var(--jr-s-6)' : 0, borderTop: i ? 'var(--jr-border) solid var(--jr-line)' : 0 } }));\n    const worksCost = eur(s.works.reduce((t, k) => t + (COST[k] || 0), 0));\n    // récap\n    const res = this.state.result, edit = n => e => { e.preventDefault(); this.goStep(n); };\n    const personne = [lab(optWho, s.who), lab(optAge, s.age), s.gir && (s.gir === 'nsp' ? 'GIR inconnu' : 'GIR ' + s.gir), s.hand && ({ non: 'sans handicap reconnu', oui_50plus: 'incapacité ≥ 50\\u202f%', oui_pch: 'PCH', inconnu: 'handicap à vérifier' })[s.hand]].filter(Boolean).join(' · ');\n    const foyer = [this.num(s.rfr) ? eur(this.num(s.rfr)) : '', s.foyer && (s.foyer === '6' ? '6 personnes et +' : s.foyer + (s.foyer === '1' ? ' personne' : ' personnes')), cat && CAT[cat]].filter(Boolean).join(' · ');\n    const recap = [\n      { key: 'Adresse', value: this.state.addr ? this.state.addr.label : '', href: '#', onEdit: edit(1) },\n      { key: 'Logement', value: [lab(optType, s.type), lab(optOcc, s.occ)].filter(Boolean).join(' · '), href: '#', onEdit: edit(1) },\n      { key: 'Personne', value: personne, href: '#', onEdit: edit(2) },\n      { key: 'Foyer', value: foyer, href: '#', onEdit: edit(5) },\n      { key: 'Aménagements', value: s.works.map(nm), href: '#', onEdit: edit(6) },\n    ];\n    let recapFooter = null;\n    if (J && step === 8 && res && res.eligible) {\n      recapFooter = h('div', { 'data-surface': 'dark', style: { padding: 'var(--jr-s-4) var(--jr-s-5)', background: 'var(--jr-ink)', color: 'var(--jr-paper)', display: 'flex', justifyContent: 'space-between', alignItems: 'baseline', gap: 'var(--jr-s-3)' } },\n        h('span', { style: { font: 'var(--jr-type-label-strong)' } }, 'Aide estimée'), h('span', { style: { font: 'var(--jr-type-amount-s)', color: 'var(--jr-sprout)', fontVariantNumeric: 'tabular-nums', whiteSpace: 'nowrap' } }, '~' + eur(this.round(res.aide.total))));\n    } else if (J && step >= 4 && eligState) {\n      const pers = ELIG[eligState], rv = revOk === null ? null : revOk;\n      const line = (k, st, word) => h('div', { key: k, style: { display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: 'var(--jr-s-2)', minHeight: 'var(--jr-s-6)' } },\n        h('span', { style: { font: 'var(--jr-type-label)', color: 'var(--jr-ink)', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', minWidth: 0 } }, k),\n        st ? h(J.StatusTag, { status: st }, word) : h('span', { style: { font: 'var(--jr-type-label)', fontWeight: 400, color: 'var(--jr-ink)', whiteSpace: 'nowrap' } }, word));\n      const eligLines = [\n\n        line('Personne', eligState === 'no' ? null : ELIG[eligState][0], eligState === 'no' ? 'Autres aides' : eligState === 'check' ? 'À vérifier' : eligState === 'gir' ? 'Selon le GIR' : 'Éligible'),\n        line('Revenus', rv === null ? null : rv ? 'valide' : null, rv === null ? '—' : rv ? 'Éligible' : 'Autres aides'),\n        rv && eligState !== 'no' ? line('Taux applicable', null, Math.round(taux * 100) + '\\u202f%') : null].filter(Boolean);\n      recapFooter = h('div', { style: { background: 'var(--jr-leaf-wash)', padding: '0 var(--jr-s-5)' } },\n        h(J.Accordion, { key: 'elig-' + (step === 4 ? 'open' : 'closed'), variant: 'dense', defaultOpen: step === 4 ? 0 : undefined, sections: [{ title: 'Éligibilité MaPrimeAdapt’', count: eligLines.length + ' critères', children: h('div', { style: { display: 'flex', flexDirection: 'column', gap: 'var(--jr-s-2)', paddingBottom: 'var(--jr-s-2)' } }, eligLines) }] }));\n    }\n    const CHECKS = ['Adresse et zone couverte', 'Situation de la personne', 'Catégorie de ressources Anah', 'Aménagements éligibles', 'Plafond de 22\\u202f000\\u202f€ HT', 'Forfait d’accompagnement'];\n    const c = this.state.calc, pct = Math.round(Math.min(c, 6) / 6 * 100);\n    const checks = CHECKS.map((l, i) => ({ label: l, status: i < c ? 'valide' : i === c ? 'en-cours' : 'a-venir', word: i < c ? 'Fait' : i === c ? 'En cours' : 'À venir',\n      row: { display: 'grid', gridTemplateColumns: 'minmax(0, 1fr) auto', alignItems: 'center', gap: 'var(--jr-s-3)', minHeight: 'var(--jr-hit)', borderTop: i ? 'var(--jr-border) solid var(--jr-line)' : 0 } }));\n    let R8 = { trio: [], rows: [], cols: [] };\n    if (res) {\n      const base = { display: 'flex', flexDirection: 'column', gap: 'var(--jr-s-3)', padding: 'var(--jr-s-4) var(--jr-s-5)', borderRadius: 'var(--jr-radius-m)', background: 'var(--jr-white)', border: 'var(--jr-border) solid var(--jr-line)', height: '100%', boxSizing: 'border-box' };\n      const T = res.travaux || {}, A = res.aide || {};\n      R8 = { total: '~' + eur(this.round(A.total)), source: 'Guide des aides de l’Anah, février 2026', date: new Date().toLocaleDateString('fr-FR'),\n        trio: [{ label: 'Coût des aménagements HT', value: eur(T.totalHT), card: base, color: 'var(--jr-ink)', labelColor: 'var(--jr-ink-70)' },\n          { label: 'Aide MaPrimeAdapt’', value: eur(A.total), card: Object.assign({}, base, { background: 'var(--jr-leaf-wash)', border: 'var(--jr-border-strong) solid var(--jr-leaf)' }), color: 'var(--jr-leaf)', labelColor: 'var(--jr-leaf)' },\n          { label: 'Reste à votre charge', value: eur(res.resteACharge), card: base, color: 'var(--jr-ink)', labelColor: 'var(--jr-ink-70)' }],\n        cols: [{ key: 'f', label: 'Élément' }, { key: 'd', label: 'Détail' }, { key: 'm', label: 'Montant', align: 'right' }],\n        rows: [{ f: 'Travaux retenus', d: (T.liste || []).map(nm).join(', '), m: eur(T.coutRetenu) + ' HT' }, { f: 'Catégorie', d: CAT[res.eligibilite.categorie] || '—', m: '' },\n          { f: 'Taux', d: 'Appliqué au coût retenu, plafonné à ' + eur(T.plafon